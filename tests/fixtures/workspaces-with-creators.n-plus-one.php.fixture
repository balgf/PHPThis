<?php

declare(strict_types=1);

use PHPThis\Database\Connection;
use PHPThis\Database\QueryBudget;
use PHPThis\Database\QueryBudgetExceeded;
use PHPThis\Database\QueryTrace;

$root = $argv[1] ?? null;
$databasePath = $argv[2] ?? null;
$budgetValue = $argv[3] ?? null;

if (!is_string($root) || !is_string($databasePath) || !is_string($budgetValue)) {
    throw new RuntimeException('Nested workspace N+1 fixture requires root, database path, and query budget arguments.');
}

if (preg_match('/^[1-9][0-9]*$/D', $budgetValue) !== 1) {
    throw new RuntimeException('Nested workspace N+1 fixture query budget must be a positive integer.');
}

$budgetLimit = filter_var($budgetValue, FILTER_VALIDATE_INT);

if (!is_int($budgetLimit) || $budgetLimit < 1) {
    throw new RuntimeException('Nested workspace N+1 fixture query budget is outside the supported integer range.');
}

require $root . '/autoload.php';

$trace = new QueryTrace(2);
$connection = Connection::connect(
    'sqlite:' . $databasePath,
    new QueryBudget($budgetLimit),
    $trace,
);
$rows = $connection->selectAllRows(
    <<<'SQL'
        SELECT
            workspaces.id AS workspace_id,
            workspaces.name AS workspace_name,
            workspaces.created_by_user_id
        FROM workspaces
        WHERE workspaces.tenant_id = :workspace_tenant_id
          AND workspaces.is_visible = :workspace_is_visible
          AND workspaces.authorized_principal_id = :workspace_authorized_principal_id
        ORDER BY workspaces.id
        LIMIT :parent_limit
        SQL,
    [
        'workspace_tenant_id' => 42,
        'workspace_is_visible' => 1,
        'workspace_authorized_principal_id' => 7,
        'parent_limit' => 50,
    ],
);
$afterLoadStatements = $trace->snapshot()['statements'];
$workspaces = [];
$budgetExceeded = false;
try {
    foreach ($rows as $row) {
        $creatorRow = $connection->selectOneRow(
            <<<'SQL'
                SELECT
                    users.id AS creator_id,
                    users.display_name AS creator_display_name,
                    users.avatar_url AS creator_avatar_url
                FROM users
                WHERE users.id = :creator_user_id
                  AND users.tenant_id = :creator_tenant_id
                  AND users.is_visible = :creator_is_visible
                  AND users.authorized_principal_id = :creator_authorized_principal_id
                SQL,
            [
                'creator_user_id' => $row['created_by_user_id'] ?? null,
                'creator_tenant_id' => 42,
                'creator_is_visible' => 1,
                'creator_authorized_principal_id' => 7,
            ],
        );
        $workspaces[] = rejectedNestedWorkspaceItem($row, $creatorRow);
    }
} catch (QueryBudgetExceeded) {
    $budgetExceeded = true;
}

$afterMappingStatements = $trace->snapshot()['statements'];
$body = json_encode(['data' => $workspaces], JSON_THROW_ON_ERROR) . "\n";
$afterEncodingStatements = $trace->snapshot()['statements'];

fwrite(STDOUT, json_encode([
    'body' => $body,
    'budget_exceeded' => $budgetExceeded,
    'phase_statements' => [
        'after_load' => $afterLoadStatements,
        'after_mapping' => $afterMappingStatements,
        'after_encoding' => $afterEncodingStatements,
    ],
    'trace' => $trace->snapshot(),
], JSON_THROW_ON_ERROR));

/**
 * @param array<string, mixed> $workspaceRow
 * @param array<string, mixed>|null $creatorRow
 * @return array{
 *     id: non-empty-string,
 *     name: non-empty-string,
 *     created_by_user_id: non-empty-string,
 *     creator: array{id: non-empty-string, display_name: non-empty-string, avatar_url: non-empty-string|null}|null
 * }
 */
function rejectedNestedWorkspaceItem(array $workspaceRow, ?array $creatorRow): array
{
    if (
        count($workspaceRow) !== 3
        || !array_key_exists('workspace_id', $workspaceRow)
        || !array_key_exists('workspace_name', $workspaceRow)
        || !array_key_exists('created_by_user_id', $workspaceRow)
    ) {
        throw new UnexpectedValueException('Nested workspace N+1 parent row has an incompatible shape.');
    }

    $workspaceId = rejectedNestedWorkspaceUuid($workspaceRow['workspace_id'], 'workspace_id');
    $workspaceName = rejectedNestedWorkspaceText(
        $workspaceRow['workspace_name'],
        'workspace_name',
        160,
    );
    $createdByUserId = rejectedNestedWorkspaceUuid(
        $workspaceRow['created_by_user_id'],
        'created_by_user_id',
    );
    $creator = null;

    if ($creatorRow !== null) {
        if (
            count($creatorRow) !== 3
            || !array_key_exists('creator_id', $creatorRow)
            || !array_key_exists('creator_display_name', $creatorRow)
            || !array_key_exists('creator_avatar_url', $creatorRow)
        ) {
            throw new UnexpectedValueException('Nested workspace N+1 creator row has an incompatible shape.');
        }

        $creatorId = rejectedNestedWorkspaceUuid($creatorRow['creator_id'], 'creator_id');

        if ($creatorId !== $createdByUserId) {
            throw new UnexpectedValueException('Nested creator id must match created_by_user_id.');
        }

        $creatorDisplayName = rejectedNestedWorkspaceText(
            $creatorRow['creator_display_name'],
            'creator_display_name',
            160,
        );
        $creatorAvatarUrlValue = $creatorRow['creator_avatar_url'];
        $creatorAvatarUrl = $creatorAvatarUrlValue === null
            ? null
            : rejectedNestedWorkspaceAvatarUrl($creatorAvatarUrlValue);
        $creator = [
            'id' => $creatorId,
            'display_name' => $creatorDisplayName,
            'avatar_url' => $creatorAvatarUrl,
        ];
    }

    return [
        'id' => $workspaceId,
        'name' => $workspaceName,
        'created_by_user_id' => $createdByUserId,
        'creator' => $creator,
    ];
}

/** @return non-empty-string */
function rejectedNestedWorkspaceUuid(mixed $value, string $field): string
{
    if (
        !is_string($value)
        || preg_match(
            '/^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/D',
            $value,
        ) !== 1
    ) {
        throw new UnexpectedValueException("Nested workspace N+1 {$field} is not a canonical lowercase UUID.");
    }

    return $value;
}

/** @return non-empty-string */
function rejectedNestedWorkspaceText(mixed $value, string $field, int $maximumBytes): string
{
    if (
        !is_string($value)
        || $value === ''
        || strlen($value) > $maximumBytes
        || preg_match('//u', $value) !== 1
    ) {
        throw new UnexpectedValueException("Nested workspace N+1 {$field} is outside its UTF-8 byte bound.");
    }

    return $value;
}

/** @return non-empty-string */
function rejectedNestedWorkspaceAvatarUrl(mixed $value): string
{
    if (
        !is_string($value)
        || $value === ''
        || strlen($value) > 2_048
        || preg_match('/^https:\/\/[!-~]+$/D', $value) !== 1
    ) {
        throw new UnexpectedValueException(
            'Nested workspace N+1 creator_avatar_url is not a bounded HTTPS URL.',
        );
    }

    return $value;
}
