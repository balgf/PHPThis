{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://phpthis.dev/schema/agent-evaluation/run-v1.json",
    "title": "PHPThis agent evaluation run v1",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema_version",
        "run_id",
        "task_id",
        "task_revision",
        "task_manifest_sha256",
        "rubric_sha256",
        "base_revision",
        "base_fixture_sha256",
        "prepared_dependencies_manifest_path",
        "prepared_dependencies_manifest_sha256",
        "condition",
        "model",
        "context",
        "tools",
        "budgets",
        "usage",
        "timing",
        "repair_turns",
        "termination_reason",
        "events_path",
        "events_sha256",
        "candidate_patch_path",
        "candidate_patch_sha256"
    ],
    "properties": {
        "schema_version": {
            "const": 1
        },
        "run_id": {
            "type": "string",
            "minLength": 1
        },
        "task_id": {
            "type": "string",
            "minLength": 1
        },
        "task_revision": {
            "type": "integer",
            "minimum": 1
        },
        "task_manifest_sha256": {
            "$ref": "#/$defs/sha256"
        },
        "rubric_sha256": {
            "$ref": "#/$defs/sha256"
        },
        "base_revision": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
        },
        "base_fixture_sha256": {
            "$ref": "#/$defs/sha256"
        },
        "prepared_dependencies_manifest_path": {
            "$ref": "#/$defs/relativePath"
        },
        "prepared_dependencies_manifest_sha256": {
            "$ref": "#/$defs/sha256"
        },
        "condition": {
            "type": "string",
            "minLength": 1
        },
        "model": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "provider",
                "id",
                "revision",
                "settings"
            ],
            "properties": {
                "provider": {
                    "type": "string",
                    "minLength": 1
                },
                "id": {
                    "type": "string",
                    "minLength": 1
                },
                "revision": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "settings": {
                    "type": "object"
                }
            }
        },
        "context": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "bundle_id",
                "bundle_sha256"
            ],
            "properties": {
                "bundle_id": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "bundle_sha256": {
                    "oneOf": [
                        {
                            "$ref": "#/$defs/sha256"
                        },
                        {
                            "type": "null"
                        }
                    ]
                }
            }
        },
        "tools": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "name",
                    "version",
                    "permissions"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "minLength": 1
                    },
                    "version": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "permissions": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "uniqueItems": true
                    }
                }
            }
        },
        "budgets": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "model_tokens",
                "wall_seconds",
                "repair_turns",
                "command_output_bytes"
            ],
            "properties": {
                "model_tokens": {
                    "type": "integer",
                    "minimum": 1
                },
                "wall_seconds": {
                    "type": "integer",
                    "minimum": 1
                },
                "repair_turns": {
                    "type": "integer",
                    "minimum": 0
                },
                "command_output_bytes": {
                    "type": "integer",
                    "minimum": 1
                }
            }
        },
        "usage": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "input_tokens",
                "output_tokens",
                "cached_tokens",
                "reasoning_tokens"
            ],
            "properties": {
                "input_tokens": {
                    "$ref": "#/$defs/nullableCount"
                },
                "output_tokens": {
                    "$ref": "#/$defs/nullableCount"
                },
                "cached_tokens": {
                    "$ref": "#/$defs/nullableCount"
                },
                "reasoning_tokens": {
                    "$ref": "#/$defs/nullableCount"
                }
            }
        },
        "timing": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "started_at",
                "finished_at"
            ],
            "properties": {
                "started_at": {
                    "type": "string",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
                },
                "finished_at": {
                    "type": "string",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
                }
            }
        },
        "repair_turns": {
            "type": "integer",
            "minimum": 0
        },
        "termination_reason": {
            "type": "string",
            "minLength": 1
        },
        "events_path": {
            "$ref": "#/$defs/relativePath"
        },
        "events_sha256": {
            "$ref": "#/$defs/sha256"
        },
        "candidate_patch_path": {
            "$ref": "#/$defs/relativePath"
        },
        "candidate_patch_sha256": {
            "$ref": "#/$defs/sha256"
        }
    },
    "$defs": {
        "nullableCount": {
            "type": [
                "integer",
                "null"
            ],
            "minimum": 0
        },
        "relativePath": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!.*[\\u0000-\\u001F\\u007F])(?!/)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$)).+$"
        },
        "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
        }
    }
}
