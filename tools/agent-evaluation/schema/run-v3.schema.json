{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://phpthis.dev/schema/agent-evaluation/run-v3.json",
    "title": "PHPThis explanation evaluation run v3",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema_version",
        "execution_kind",
        "run_id",
        "task_id",
        "task_revision",
        "task_manifest_sha256",
        "prompt_sha256",
        "effective_prompt_sha256",
        "rubric_sha256",
        "base_revision",
        "base_tree",
        "base_fixture_sha256",
        "prepared_dependencies_manifest_path",
        "prepared_dependencies_manifest_sha256",
        "prepared_lock_path",
        "prepared_lock_sha256",
        "prepared_installed_metadata_path",
        "prepared_installed_metadata_sha256",
        "prepared_installed_package_count",
        "condition",
        "runner",
        "model",
        "context",
        "tools",
        "transport_tools",
        "budgets",
        "usage",
        "timing",
        "repair_turns",
        "termination_reason",
        "events_path",
        "events_sha256",
        "candidate_patch_path",
        "candidate_patch_sha256",
        "response_path",
        "response_sha256"
    ],
    "properties": {
        "schema_version": {
            "const": 3
        },
        "execution_kind": {
            "enum": [
                "live-model",
                "synthetic-control"
            ]
        },
        "run_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
        },
        "task_id": {
            "const": "explain.file-profile-s3"
        },
        "task_revision": {
            "type": "integer",
            "minimum": 1
        },
        "task_manifest_sha256": {
            "$ref": "#/$defs/sha256"
        },
        "prompt_sha256": {
            "$ref": "#/$defs/sha256"
        },
        "effective_prompt_sha256": {
            "$ref": "#/$defs/sha256"
        },
        "rubric_sha256": {
            "$ref": "#/$defs/sha256"
        },
        "base_revision": {
            "const": "d7ab170c190c9fd7e18be3ca00b874a8d954fa2b"
        },
        "base_tree": {
            "const": "3b017642ecc90fbc5af93f2f9454cb86d1e2add7"
        },
        "base_fixture_sha256": {
            "$ref": "#/$defs/sha256"
        },
        "prepared_dependencies_manifest_path": {
            "$ref": "#/$defs/relativePath"
        },
        "prepared_dependencies_manifest_sha256": {
            "$ref": "#/$defs/sha256"
        },
        "prepared_lock_path": {
            "oneOf": [
                {
                    "$ref": "#/$defs/relativePath"
                },
                {
                    "type": "null"
                }
            ]
        },
        "prepared_lock_sha256": {
            "oneOf": [
                {
                    "$ref": "#/$defs/sha256"
                },
                {
                    "type": "null"
                }
            ]
        },
        "prepared_installed_metadata_path": {
            "oneOf": [
                {
                    "$ref": "#/$defs/relativePath"
                },
                {
                    "type": "null"
                }
            ]
        },
        "prepared_installed_metadata_sha256": {
            "oneOf": [
                {
                    "$ref": "#/$defs/sha256"
                },
                {
                    "type": "null"
                }
            ]
        },
        "prepared_installed_package_count": {
            "type": [
                "integer",
                "null"
            ],
            "minimum": 0,
            "maximum": 4000
        },
        "condition": {
            "const": "repository-only"
        },
        "runner": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "name",
                "version"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "version": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "model": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "provider",
                "id",
                "revision",
                "settings"
            ],
            "properties": {
                "provider": {
                    "type": "string",
                    "minLength": 1
                },
                "id": {
                    "type": "string",
                    "minLength": 1
                },
                "revision": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "settings": {
                    "type": "object"
                }
            }
        },
        "context": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "bundle_id",
                "bundle_sha256"
            ],
            "properties": {
                "bundle_id": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "bundle_sha256": {
                    "oneOf": [
                        {
                            "$ref": "#/$defs/sha256"
                        },
                        {
                            "type": "null"
                        }
                    ]
                }
            }
        },
        "tools": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "name",
                    "version",
                    "permissions"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "minLength": 1
                    },
                    "version": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "permissions": {
                        "type": "array",
                        "uniqueItems": true,
                        "items": {
                            "type": "string"
                        },
                        "not": {
                            "contains": {
                                "const": "workspace-write"
                            }
                        }
                    }
                }
            }
        },
        "transport_tools": {
            "oneOf": [
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "kind",
                        "count",
                        "sha256"
                    ],
                    "properties": {
                        "kind": {
                            "type": "string",
                            "minLength": 1
                        },
                        "count": {
                            "type": "integer",
                            "minimum": 1
                        },
                        "sha256": {
                            "$ref": "#/$defs/sha256"
                        }
                    }
                },
                {
                    "type": "null"
                }
            ]
        },
        "budgets": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "model_tokens",
                "wall_seconds",
                "repair_turns",
                "command_output_bytes"
            ],
            "properties": {
                "model_tokens": {
                    "enum": [
                        40000,
                        100000,
                        200000
                    ]
                },
                "wall_seconds": {
                    "const": 1200
                },
                "repair_turns": {
                    "const": 0
                },
                "command_output_bytes": {
                    "const": 4194304
                }
            }
        },
        "usage": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "input_tokens",
                "output_tokens",
                "cached_tokens",
                "reasoning_tokens"
            ],
            "properties": {
                "input_tokens": {
                    "$ref": "#/$defs/tokenCount"
                },
                "output_tokens": {
                    "$ref": "#/$defs/tokenCount"
                },
                "cached_tokens": {
                    "$ref": "#/$defs/tokenCount"
                },
                "reasoning_tokens": {
                    "$ref": "#/$defs/tokenCount"
                }
            }
        },
        "timing": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "started_at",
                "finished_at"
            ],
            "properties": {
                "started_at": {
                    "$ref": "#/$defs/timestamp"
                },
                "finished_at": {
                    "$ref": "#/$defs/timestamp"
                }
            }
        },
        "repair_turns": {
            "const": 0
        },
        "termination_reason": {
            "const": "completed"
        },
        "events_path": {
            "$ref": "#/$defs/relativePath"
        },
        "events_sha256": {
            "$ref": "#/$defs/sha256"
        },
        "candidate_patch_path": {
            "$ref": "#/$defs/relativePath"
        },
        "candidate_patch_sha256": {
            "const": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
        },
        "response_path": {
            "$ref": "#/$defs/relativePath"
        },
        "response_sha256": {
            "$ref": "#/$defs/sha256"
        }
    },
    "$defs": {
        "relativePath": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!.*[\\u0000-\\u001F\\u007F])(?!/)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$)).+$"
        },
        "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
        },
        "timestamp": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "tokenCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 200000
        }
    },
    "allOf": [
        {
            "if": {
                "properties": {
                    "execution_kind": {
                        "const": "live-model"
                    }
                }
            },
            "then": {
                "properties": {
                    "condition": {
                        "const": "repository-only"
                    },
                    "runner": {
                        "const": {
                            "name": "codex-exec",
                            "version": "0.153.1"
                        }
                    },
                    "model": {
                        "const": {
                            "provider": "openai",
                            "id": "gpt-5.4-2026-03-05",
                            "revision": null,
                            "settings": {
                                "reasoning_effort": "high"
                            }
                        }
                    },
                    "context": {
                        "const": {
                            "bundle_id": null,
                            "bundle_sha256": null
                        }
                    },
                    "tools": {
                        "const": [
                            {
                                "name": "shell",
                                "version": null,
                                "permissions": [
                                    "workspace-read",
                                    "process-execute"
                                ]
                            }
                        ]
                    },
                    "transport_tools": {
                        "const": {
                            "kind": "codex-responses-local-tools-v1",
                            "count": 4,
                            "sha256": "3392681cd5b82960557ffe2ce5b0ba1e223cc0f97a226432a7a43353475d6aed"
                        }
                    },
                    "prepared_lock_path": {
                        "const": "dependencies.lock"
                    },
                    "prepared_lock_sha256": {
                        "$ref": "#/$defs/sha256"
                    },
                    "prepared_installed_metadata_path": {
                        "const": "dependencies.installed.json"
                    },
                    "prepared_installed_metadata_sha256": {
                        "$ref": "#/$defs/sha256"
                    },
                    "prepared_installed_package_count": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 4000
                    }
                }
            },
            "else": {
                "properties": {
                    "runner": {
                        "properties": {
                            "name": {
                                "const": "fake-codex"
                            }
                        }
                    },
                    "model": {
                        "properties": {
                            "provider": {
                                "const": "synthetic"
                            }
                        }
                    },
                    "transport_tools": {
                        "type": "null"
                    },
                    "prepared_lock_path": {
                        "type": "null"
                    },
                    "prepared_lock_sha256": {
                        "type": "null"
                    },
                    "prepared_installed_metadata_path": {
                        "type": "null"
                    },
                    "prepared_installed_metadata_sha256": {
                        "type": "null"
                    },
                    "prepared_installed_package_count": {
                        "type": "null"
                    }
                }
            }
        }
    ]
}
