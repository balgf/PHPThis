{
    "name": "evaluation/repair-transaction-rollback-phpthis",
    "type": "project",
    "require": {
        "php": "~8.4.0",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "phpthis/framework": "dev-main#094f61ef29636536ccfd706e514e4ffa11511ae6"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "profile": "phpthis check",
        "test": "php tests/smoke.php",
        "check": [
            "@profile",
            "@test"
        ]
    },
    "config": {
        "allow-plugins": false,
        "sort-packages": true
    }
}
