{
    "name": "evaluation/change-filtered-collection-phpthis",
    "type": "project",
    "require": {
        "php": "~8.4.0",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "phpthis/framework": "dev-main#1245e4b3ae6b8888b9f93d7c320039e3f8bda0e2"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "profile": "phpthis check",
        "test": "php tests/smoke.php",
        "check": [
            "@profile",
            "@test"
        ]
    },
    "config": {
        "allow-plugins": false,
        "sort-packages": true
    }
}
