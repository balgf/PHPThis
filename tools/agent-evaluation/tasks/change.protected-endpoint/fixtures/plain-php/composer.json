{
    "name": "evaluation/change-protected-endpoint-plain-php",
    "type": "project",
    "require": {
        "php": "~8.4.0",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "profile": "php vendor/bin/phpstan analyse --configuration=phpstan.neon --debug --no-progress --memory-limit=512M",
        "test": "php tests/smoke.php",
        "check": [
            "@profile",
            "@test"
        ]
    },
    "config": {
        "allow-plugins": false,
        "sort-packages": true
    }
}
