@@ -0,0 +1,57 @@
+<?php
+
+declare(strict_types=1);
+namespace App;
+use App\Accounts\AuthenticateAccountRequest;
+use App\Accounts\ResolveAccountTenant;
+use App\Accounts\Unauthenticated;
+use App\Accounts\Forbidden;
+use App\Users\CreateUser\CanCreateUser;
+use App\Users\CreateUser\AuthorizeCreateUser;
+use App\Users\CreateUser\CreateUserHandler;
+use App\Users\CreateUser\CreateUserConflict;
+use App\Users\CreateUser\UnacceptableCreateUser;
+use App\Users\CreateUser\UnsupportedCreateMedia;
+use App\Users\ListUsers\CanListUsers;
+use App\Users\ListUsers\AuthorizeListUsers;
+use App\Users\ListUsers\ListUsersHandler;
+use App\Observability\CorrelationId;
+use App\Observability\QuerySummarySource;
+use App\Observability\RequestSummarySink;
+use App\Observability\TerminalRequestCoordinator;
+use PHPThis\Application;
+use PHPThis\Database\Connection;
+use PHPThis\Database\QueryBudget;
+use PHPThis\Database\QueryTrace;
+use PHPThis\Http\ErrorResponseRegistry;
+use PHPThis\Http\InvalidRequest;
+use PHPThis\Http\RequestBodyTooLarge;
+use PHPThis\Http\RequestBoundary;
+use PHPThis\Http\RequestReader;
+use PHPThis\Http\Response;
+use PHPThis\Http\UnknownFailureBoundary;
+use PHPThis\Routing\Router;
+final class DirectoryComposition
+{
+    public static function create(Connection $connection, QueryBudget $budget, QueryTrace $trace,
+        AuthenticateAccountRequest $authentication, ResolveAccountTenant $tenants,
+        CanCreateUser $createAuthorization, CanListUsers $listAuthorization, RequestSummarySink $sink,
+        string $bodyStream = 'php://input'): TerminalRequestCoordinator
+    {
+        $headers = ['Content-Type' => 'application/json; charset=utf-8', 'Cache-Control' => 'private, no-store'];
+        $routes = Routes::create(
+            new AuthorizeCreateUser($authentication, $tenants, $createAuthorization, new CreateUserHandler($connection)),
+            new AuthorizeListUsers($authentication, $tenants, $listAuthorization, new ListUsersHandler($connection)));
+        return new TerminalRequestCoordinator(new RequestBoundary(new RequestReader(1024, $bodyStream),
+            new Application(new Router($routes)), new ErrorResponseRegistry([
+                InvalidRequest::class => new Response(400, $headers, "{\"error\":\"invalid_request\"}\n"),
+                RequestBodyTooLarge::class => new Response(413, $headers, "{\"error\":\"request_body_too_large\"}\n"),
+                Unauthenticated::class => new Response(401, $headers + ['WWW-Authenticate' => 'Bearer'], "{\"error\":\"unauthenticated\"}\n"),
+                Forbidden::class => new Response(403, $headers, "{\"error\":\"forbidden\"}\n"),
+                UnacceptableCreateUser::class => new Response(422, $headers, "{\"error\":\"unprocessable_content\",\"message\":\"Request content is unacceptable.\"}\n"),
+                UnsupportedCreateMedia::class => new Response(415, $headers, "{\"error\":\"unsupported_media_type\"}\n"),
+                CreateUserConflict::class => new Response(409, $headers, "{\"error\":\"create_conflict\"}\n"),
+            ])), new UnknownFailureBoundary(), CorrelationId::generate(), $sink,
+            [new QuerySummarySource('directory', $budget, $trace)]);
+    }
+}
