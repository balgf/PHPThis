+<?php
+
+declare(strict_types=1);
+namespace App\Users\ListUsers;
+use App\Users\UserId;
+use PHPThis\Http\InvalidRequest;
+final readonly class ListUsersPage
+{
+    private function __construct(public ?UserId $after) {}
+    /** @param array<string, mixed> $query */
+    public static function fromQuery(array $query): self
+    {
+        if (array_diff(array_keys($query), ['after_user_id']) !== []) { throw new InvalidRequest(); }
+        if (!array_key_exists('after_user_id', $query)) { return new self(null); }
+        $raw = $query['after_user_id'];
+        if (!is_string($raw) || preg_match('/\A[1-9][0-9]{0,18}\z/D', $raw) !== 1) { throw new InvalidRequest(); }
+        $id = filter_var($raw, FILTER_VALIDATE_INT);
+        if (!is_int($id) || $id < 1) { throw new InvalidRequest(); }
+        return new self(UserId::fromInteger($id));
+    }
+}
