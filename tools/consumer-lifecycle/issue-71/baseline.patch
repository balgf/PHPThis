+<?php
+
+declare(strict_types=1);
+namespace EvaluationTests;
+use App\Accounts\AccountId;
+use App\Accounts\AuthenticateAccountRequest;
+use App\Accounts\Principal;
+use App\Accounts\ResolveAccountTenant;
+use App\Accounts\SameAccountTenant;
+use App\Accounts\Tenant;
+use App\Accounts\Unauthenticated;
+use App\Users\CreateUser\AccountCreateAuthorization;
+use App\Users\CreateUser\CanCreateUser;
+use App\Users\ListUsers\AccountListAuthorization;
+use App\Users\ListUsers\CanListUsers;
+use PHPThis\Http\Request;
+final class PolicyLog { /** @var list<string> */ public array $calls = []; }
+final readonly class SyntheticAuthentication implements AuthenticateAccountRequest
+{
+    public function __construct(private PolicyLog $log, private bool $fail = false) {}
+    public function authenticate(Request $request): Principal
+    {
+        $this->log->calls[] = 'authenticate';
+        if ($this->fail) { throw new \RuntimeException('policy-private-marker'); }
+        return match ($request->headers['authorization'] ?? '') {
+            'Bearer fixture-writer' => new Principal(101, AccountId::fromInteger(1), true),
+            'Bearer fixture-reader' => new Principal(101, AccountId::fromInteger(1), false),
+            default => throw new Unauthenticated(),
+        };
+    }
+}
+final readonly class SyntheticTenantResolution implements ResolveAccountTenant
+{
+    public function __construct(private PolicyLog $log, private bool $fail = false) {}
+    public function resolve(Principal $principal, AccountId $requested): Tenant
+    {
+        $this->log->calls[] = 'tenant';
+        if ($this->fail) { throw new \RuntimeException('policy-private-marker'); }
+        return new SameAccountTenant()->resolve($principal, $requested);
+    }
+}
+final readonly class SyntheticCreateAuthorization implements CanCreateUser
+{
+    public function __construct(private PolicyLog $log, private bool $fail = false) {}
+    public function authorize(Principal $principal, Tenant $tenant): void
+    {
+        $this->log->calls[] = 'create';
+        if ($this->fail) { throw new \RuntimeException('policy-private-marker'); }
+        new AccountCreateAuthorization()->authorize($principal, $tenant);
+    }
+}
+final readonly class SyntheticListAuthorization implements CanListUsers
+{
+    public function __construct(private PolicyLog $log, private bool $fail = false) {}
+    public function authorize(Principal $principal, Tenant $tenant): void
+    {
+        $this->log->calls[] = 'list';
+        if ($this->fail) { throw new \RuntimeException('policy-private-marker'); }
+        new AccountListAuthorization()->authorize($principal, $tenant);
+    }
+}
