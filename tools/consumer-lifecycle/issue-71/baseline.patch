+<?php
+
+declare(strict_types=1);
+namespace App\Users\ListUsers;
+use App\Accounts\AccountId;
+use App\Accounts\Forbidden;
+use App\Accounts\Principal;
+use App\Accounts\Tenant;
+use PHPThis\Database\Connection;
+use PHPThis\Http\Response;
+final readonly class ListUsersHandler
+{
+    public function __construct(private Connection $connection) {}
+    public function handle(Principal $principal, Tenant $tenant, AccountId $requested, ListUsersPage $page): Response
+    {
+        if ($requested->toInteger() !== $tenant->account->toInteger()
+            || $principal->account->toInteger() !== $tenant->account->toInteger()) { throw new Forbidden(); }
+        $rows = $this->connection->selectAllRows(
+            'SELECT u.id, u.name, u.email FROM account_users AS au JOIN users AS u ON u.id = au.user_id WHERE au.account_id = :requested_account AND au.account_id = :tenant_account AND EXISTS (SELECT 1 FROM account_memberships WHERE principal_id = :principal_id AND account_id = :actor_account) AND u.id > :after_id ORDER BY u.id ASC LIMIT :row_limit',
+            ['requested_account' => $requested->toInteger(), 'tenant_account' => $tenant->account->toInteger(),
+                'principal_id' => $principal->id, 'actor_account' => $tenant->account->toInteger(),
+                'after_id' => $page->after?->toInteger() ?? 0, 'row_limit' => 21]);
+        $data = [];
+        $lastId = null;
+        foreach ($rows as $row) {
+            $user = UserSummary::fromDatabaseRow($row);
+            if (count($data) < 20) {
+                $data[] = ['id' => $user->id->toInteger(), 'name' => $user->name, 'email' => $user->email];
+                $lastId = $user->id->toInteger();
+            }
+        }
+        return new Response(200, ['Content-Type' => 'application/json; charset=utf-8', 'Cache-Control' => 'private, no-store'],
+            json_encode(['data' => $data, 'next_after_user_id' => count($rows) > 20 ? $lastId : null], JSON_THROW_ON_ERROR) . "\n");
+    }
+}
