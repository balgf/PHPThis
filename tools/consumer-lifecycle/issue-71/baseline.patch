new file mode 100644
index 0000000..4f00382
--- /dev/null
+++ b/src/Users/CreateUser/CreateUserHandler.php
@@ -0,0 +1,40 @@
+<?php
+
+declare(strict_types=1);
+namespace App\Users\CreateUser;
+use App\Accounts\AccountId;
+use App\Accounts\Forbidden;
+use App\Accounts\Principal;
+use App\Accounts\Tenant;
+use PHPThis\Database\Connection;
+use PHPThis\Http\Response;
+final readonly class CreateUserHandler
+{
+    public function __construct(private Connection $connection) {}
+    public function handle(Principal $principal, Tenant $tenant, AccountId $requested, CreateUserCommand $command): Response
+    {
+        if ($requested->toInteger() !== $tenant->account->toInteger()
+            || $principal->account->toInteger() !== $tenant->account->toInteger() || !$principal->mayCreate) {
+            throw new Forbidden();
+        }
+        $response = new Response(201, ['Content-Type' => 'application/json; charset=utf-8', 'Cache-Control' => 'private, no-store'],
+            json_encode(['data' => ['id' => $command->id->toInteger(), 'name' => $command->name, 'email' => $command->email]], JSON_THROW_ON_ERROR) . "\n");
+        $this->connection->beginTransaction();
+        try {
+            $inserted = $this->connection->executeStatement(
+                'INSERT INTO users (id, name, email) SELECT :user_id, :name, :email WHERE EXISTS (SELECT 1 FROM account_memberships WHERE principal_id = :principal_id AND account_id = :actor_account) ON CONFLICT(id) DO NOTHING',
+                ['user_id' => $command->id->toInteger(), 'name' => $command->name, 'email' => $command->email,
+                    'principal_id' => $principal->id, 'actor_account' => $tenant->account->toInteger()]);
+            if ($inserted !== 1) { throw new CreateUserConflict(); }
+            $linked = $this->connection->executeStatement('INSERT INTO account_users (account_id, user_id) VALUES (:account_id, :user_id)',
+                ['account_id' => $tenant->account->toInteger(), 'user_id' => $command->id->toInteger()]);
+            $recorded = $this->connection->executeStatement('INSERT INTO user_events (account_id, user_id, principal_id, event) VALUES (:account_id, :user_id, :principal_id, :event)',
+                ['account_id' => $tenant->account->toInteger(), 'user_id' => $command->id->toInteger(), 'principal_id' => $principal->id, 'event' => 'user.created']);
+            if ($linked !== 1 || $recorded !== 1) { throw new \RuntimeException('Incomplete create.'); }
+            $this->connection->commit();
+        } finally {
+            if ($this->connection->inTransaction()) { $this->connection->rollBack(); }
+        }
+        return $response;
+    }
+}
