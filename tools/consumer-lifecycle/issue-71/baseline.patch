+#!/usr/bin/env python3
+"""Real loopback SAPI checks; only owned scratch fixtures and child processes."""
+import http.client
+import json
+import os
+from pathlib import Path
+import shutil
+import socket
+import subprocess
+import tempfile
+import time
+
+APP = Path(__file__).resolve().parent.parent
+PHP = shutil.which("php")
+assert PHP, "PHP is required"
+
+def request(port, method, path, body=None, credential=None):
+    connection = http.client.HTTPConnection("127.0.0.1", port, timeout=3)
+    headers = {"Content-Type": "application/json"}
+    if credential:
+        headers["Authorization"] = credential
+    connection.request(method, path, body=body, headers=headers)
+    response = connection.getresponse()
+    result = response.status, dict(response.getheaders()), response.read()
+    connection.close()
+    return result
+
+def exercise(root, synthetic):
+    with socket.socket() as sock:
+        sock.bind(("127.0.0.1", 0))
+        port = sock.getsockname()[1]
+    application_log = root / "application.log"
+    with (root / "server.log").open("wb") as output:
+        process = subprocess.Popen([PHP, "-d", "display_errors=0", "-d", "display_startup_errors=0",
+            "-d", "error_reporting=-1", "-d", "log_errors=1", "-d", "zend.exception_ignore_args=1",
+            "-d", f"error_log={application_log}", "-S", f"127.0.0.1:{port}",
+            "-t", str(root / "public"), str(root / "public/index.php")], cwd=root, stdout=output, stderr=output)
+        try:
+            deadline = time.monotonic() + 5
+            while True:
+                try:
+                    with socket.create_connection(("127.0.0.1", port), timeout=.2):
+                        break
+                except OSError:
+                    if process.poll() is not None or time.monotonic() > deadline:
+                        raise AssertionError("HTTP process failed to become ready")
+                    time.sleep(.02)
+            status, headers, body = request(port, "GET", "/health")
+            assert status == 200 and body == b'{"status":"ok"}\n'
+            assert headers["Cache-Control"] == "no-store"
+            assert len(headers["X-Request-ID"]) == 32
+            status, headers, body = request(port, "GET", "/accounts/1/users")
+            assert status == 401 and body == b'{"error":"unauthenticated"}\n'
+            assert headers["Cache-Control"] == "private, no-store"
+            if synthetic:
+                status, headers, body = request(port, "POST", "/accounts/1/users",
+                    json.dumps({"id": 8001, "name": "HTTP private marker", "email": "http@example.test"}), "Bearer fixture-writer")
+                assert status == 201 and json.loads(body)["data"]["id"] == 8001
+                status, headers, body = request(port, "GET", "/accounts/1/users", credential="Bearer fixture-writer")
+                assert status == 200 and len(json.loads(body)["data"]) == 20
+                status, headers, body = request(port, "GET", "/accounts/2/users", credential="Bearer fixture-writer")
+                assert status == 403 and b"Foreign private marker" not in body
+            else:
+                status, _, _ = request(port, "POST", "/accounts/1/users", '{}', "Bearer fixture-writer")
+                assert status == 401, "normal composition must deny test credentials"
+        finally:
+            process.terminate()
+            try:
+                process.wait(timeout=5)
+            except subprocess.TimeoutExpired:
+                process.kill()
+                process.wait(timeout=5)
+    logs = application_log.read_text()
+    assert "HTTP private marker" not in logs and "http@example.test" not in logs
+    assert "fixture-writer" not in logs and "Foreign private marker" not in logs
+    summaries = [json.loads(line[line.index('{'):]) for line in logs.splitlines() if '{"schema_version"' in line]
+    assert len(summaries) == (5 if synthetic else 3)
+    assert [item["query_count"] for item in summaries] == ([0, 0, 3, 1, 0] if synthetic else [0, 0, 0])
+    assert all(item["schema_version"] == 1 for item in summaries)
+
+with tempfile.TemporaryDirectory(prefix="phpthis-directory-http-") as scratch:
+    root = Path(scratch)
+    (root / "public").mkdir()
+    (root / "tmp").mkdir(mode=0o700)
+    shutil.copy2(APP / "public/index.php", root / "public/index.php")
+    shutil.copy2(APP / "bootstrap.php", root / "bootstrap.php")
+    shutil.copy2(APP / "tmp/directory.sqlite", root / "tmp/directory.sqlite")
+    os.symlink(APP / "vendor", root / "vendor", target_is_directory=True)
+    assert (root / "public/index.php").read_bytes() == (APP / "public/index.php").read_bytes()
+    exercise(root, False)
+    (root / "application.log").unlink()
+    # Explicit test-only policy injection. App classes and dependencies come from the same installed vendor autoloader.
+    bootstrap = (APP / "bootstrap.php").read_text()
+    bootstrap = bootstrap.replace("new DenyAllAuthentication()", "new \\EvaluationTests\\SyntheticAuthentication(new \\EvaluationTests\\PolicyLog())")
+    fixture_path = str(APP / "tests/PolicyFixtures.php").replace("'", "\\'")
+    bootstrap = bootstrap.replace("$databasePath =", f"require '{fixture_path}';\n$databasePath =")
+    (root / "bootstrap.php").write_text(bootstrap)
+    exercise(root, True)
+print("PASS real HTTP: unchanged front controller, deny-all default, injected Create/List, tenant denial, summary counts/redaction")
