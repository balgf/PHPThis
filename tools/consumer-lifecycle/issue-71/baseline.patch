+<?php
+
+declare(strict_types=1);
+namespace EvaluationTests;
+use PHPThis\Database\Connection;
+use PHPThis\Database\QueryBudget;
+use PHPThis\Database\QueryTrace;
+final class DirectoryFixture
+{
+    public static function dsn(): string { return 'sqlite:' . dirname(__DIR__) . '/tmp/directory.sqlite'; }
+    public static function reset(int $users): void
+    {
+        if ($users < 1 || $users > 500) { throw new \InvalidArgumentException('Fixture bound.'); }
+        $directory = dirname(__DIR__) . '/tmp';
+        if (!is_dir($directory) && !mkdir($directory, 0700)) { throw new \RuntimeException('Fixture directory.'); }
+        $file = $directory . '/directory.sqlite';
+        if (is_file($file) && !unlink($file)) { throw new \RuntimeException('Fixture reset.'); }
+        $connection = Connection::connect(self::dsn(), new QueryBudget(10), new QueryTrace(10));
+        if (!chmod($file, 0600)) { throw new \RuntimeException('Fixture permissions.'); }
+        $connection->executeStatement('CREATE TABLE users (id INTEGER PRIMARY KEY CHECK (id > 0), name TEXT NOT NULL, email TEXT NOT NULL)');
+        $connection->executeStatement('CREATE TABLE account_users (account_id INTEGER NOT NULL, user_id INTEGER NOT NULL UNIQUE, PRIMARY KEY (account_id, user_id))');
+        $connection->executeStatement('CREATE TABLE account_memberships (principal_id INTEGER NOT NULL, account_id INTEGER NOT NULL, PRIMARY KEY (principal_id, account_id))');
+        $connection->executeStatement('CREATE TABLE user_events (account_id INTEGER NOT NULL, user_id INTEGER NOT NULL, principal_id INTEGER NOT NULL, event TEXT NOT NULL)');
+        $connection->executeStatement('INSERT INTO account_memberships (principal_id, account_id) VALUES (101, 1), (202, 2)');
+        $connection->executeStatement("WITH RECURSIVE fixture(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM fixture WHERE n < :count) INSERT INTO users (id, name, email) SELECT n, 'User ' || n, 'user' || n || '@example.test' FROM fixture", ['count' => $users]);
+        $connection->executeStatement('INSERT INTO account_users (account_id, user_id) SELECT :account, id FROM users', ['account' => 1]);
+        $connection->executeStatement('INSERT INTO users (id, name, email) VALUES (:id, :name, :email)', ['id' => 9001, 'name' => 'Foreign private marker', 'email' => 'foreign@example.test']);
+        $connection->executeStatement('INSERT INTO account_users (account_id, user_id) VALUES (:account, :user)', ['account' => 2, 'user' => 9001]);
+    }
+    /** @return array<string, mixed> */
+    public static function counts(): array
+    {
+        $connection = Connection::connect(self::dsn(), new QueryBudget(1), new QueryTrace(1));
+        return $connection->selectOneRow('SELECT (SELECT COUNT(*) FROM users) AS users, (SELECT COUNT(*) FROM account_users) AS links, (SELECT COUNT(*) FROM user_events) AS events, (SELECT COUNT(*) FROM account_memberships) AS memberships') ?? throw new \RuntimeException('Missing fixture counts.');
+    }
+    public static function failAudit(): void
+    {
+        $connection = Connection::connect(self::dsn(), new QueryBudget(1), new QueryTrace(1));
+        $connection->executeStatement("CREATE TRIGGER fail_audit BEFORE INSERT ON user_events BEGIN SELECT RAISE(ABORT, 'fixture-private-failure'); END");
+    }
+}
