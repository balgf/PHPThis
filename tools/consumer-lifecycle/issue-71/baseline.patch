+<?php
+
+declare(strict_types=1);
+namespace App\Users\ListUsers;
+use App\Users\UserId;
+final readonly class UserSummary
+{
+    private function __construct(public UserId $id, public string $name, public string $email) {}
+    /** @param array<string, mixed> $row */
+    public static function fromDatabaseRow(array $row): self
+    {
+        if (count($row) !== 3 || !is_int($row['id'] ?? null) || !is_string($row['name'] ?? null)
+            || !is_string($row['email'] ?? null) || $row['id'] < 1 || $row['name'] === '' || strlen($row['name']) > 80
+            || preg_match('//u', $row['name']) !== 1 || preg_match('/[\x00-\x1f\x7f]/', $row['name']) === 1
+            || trim($row['name']) !== $row['name'] || strlen($row['email']) > 254
+            || filter_var($row['email'], FILTER_VALIDATE_EMAIL) !== $row['email']) {
+            throw new \UnexpectedValueException('Invalid stored user.');
+        }
+        return new self(UserId::fromInteger($row['id']), $row['name'], $row['email']);
+    }
+}
