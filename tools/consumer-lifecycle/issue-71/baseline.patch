+<?php
+
+declare(strict_types=1);
+namespace App\Users\ListUsers;
+use App\Accounts\AccountId;
+use App\Accounts\AuthenticateAccountRequest;
+use App\Accounts\ResolveAccountTenant;
+use PHPThis\Http\Request;
+use PHPThis\Http\RequestHandler;
+use PHPThis\Http\Response;
+final readonly class AuthorizeListUsers implements RequestHandler
+{
+    public function __construct(private AuthenticateAccountRequest $authentication, private ResolveAccountTenant $tenants,
+        private CanListUsers $authorization, private ListUsersHandler $handler) {}
+    public function handle(Request $request): Response
+    {
+        $principal = $this->authentication->authenticate($request);
+        $account = AccountId::fromInteger($request->pathParameters->positiveInteger('account_id'));
+        $tenant = $this->tenants->resolve($principal, $account);
+        $this->authorization->authorize($principal, $tenant);
+        $page = ListUsersPage::fromQuery($request->query);
+        return $this->handler->handle($principal, $tenant, $account, $page);
+    }
+}
