@@ -0,0 +1,30 @@
+<?php
+
+declare(strict_types=1);
+namespace App\Users\CreateUser;
+use App\Users\UserId;
+use PHPThis\Http\InvalidRequest;
+use PHPThis\Http\RequestBodyTooLarge;
+final readonly class CreateUserCommand
+{
+    private function __construct(public UserId $id, public string $name, public string $email) {}
+    public static function fromJson(string $body): self
+    {
+        if (strlen($body) > 1024) { throw new RequestBodyTooLarge(); }
+        try { $value = json_decode($body, false, 8, JSON_THROW_ON_ERROR); }
+        catch (\JsonException) { throw new InvalidRequest(); }
+        if (!$value instanceof \stdClass) { throw new InvalidRequest(); }
+        $fields = get_object_vars($value);
+        if (count($fields) !== 3 || !array_key_exists('id', $fields)
+            || !array_key_exists('name', $fields) || !array_key_exists('email', $fields)
+            || !is_int($fields['id']) || !is_string($fields['name']) || !is_string($fields['email'])) {
+            throw new InvalidRequest();
+        }
+        if ($fields['id'] < 1 || $fields['name'] === '' || strlen($fields['name']) > 80
+            || trim($fields['name']) !== $fields['name'] || preg_match('/[\x00-\x1f\x7f]/', $fields['name']) === 1
+            || strlen($fields['email']) > 254 || filter_var($fields['email'], FILTER_VALIDATE_EMAIL) !== $fields['email']) {
+            throw new UnacceptableCreateUser();
+        }
+        return new self(UserId::fromInteger($fields['id']), $fields['name'], $fields['email']);
+    }
+}
