@@ -0,0 +1,156 @@
+<?php
+
+declare(strict_types=1);
+
+require dirname(__DIR__) . '/vendor/autoload.php';
+require __DIR__ . '/DirectoryFixture.php';
+require __DIR__ . '/PolicyFixtures.php';
+
+use App\DirectoryComposition;
+use App\Observability\RequestSummary;
+use App\Observability\RequestSummarySink;
+use EvaluationTests\DirectoryFixture;
+use EvaluationTests\PolicyLog;
+use EvaluationTests\SyntheticAuthentication;
+use EvaluationTests\SyntheticTenantResolution;
+use EvaluationTests\SyntheticCreateAuthorization;
+use EvaluationTests\SyntheticListAuthorization;
+use PHPThis\Database\Connection;
+use PHPThis\Database\QueryBudget;
+use PHPThis\Database\QueryTrace;
+use PHPThis\Http\Response;
+
+final class DirectoryRecordingSink implements RequestSummarySink
+{
+    public ?RequestSummary $summary = null;
+    public int $attempts = 0;
+    public function emit(RequestSummary $summary): void
+    {
+        $this->summary = $summary;
+        $this->attempts++;
+    }
+}
+
+function directoryExpect(mixed $expected, mixed $actual, string $label): void
+{
+    if ($actual !== $expected) {
+        throw new RuntimeException($label . ': ' . json_encode([$expected, $actual], JSON_THROW_ON_ERROR));
+    }
+}
+
+/** @param array<string, mixed> $query
+ * @return array{response: Response, statements: int, summary: RequestSummary, order: list<string>, trace: string}
+ */
+function directoryRequest(string $method = 'GET', string $path = '/accounts/1/users',
+    string $credential = 'Bearer fixture-writer', string $body = '', array $query = [],
+    string $media = 'application/json', ?string $failStage = null): array
+{
+    $budget = new QueryBudget($method === 'POST' ? 3 : 1);
+    $trace = new QueryTrace(3);
+    $connection = Connection::connect(DirectoryFixture::dsn(), $budget, $trace);
+    $sink = new DirectoryRecordingSink();
+    $log = new PolicyLog();
+    $coordinator = DirectoryComposition::create($connection, $budget, $trace,
+        new SyntheticAuthentication($log, $failStage === 'authenticate'),
+        new SyntheticTenantResolution($log, $failStage === 'tenant'),
+        new SyntheticCreateAuthorization($log, $failStage === 'authorize'),
+        new SyntheticListAuthorization($log, $failStage === 'authorize'),
+        $sink, 'data://text/plain;base64,' . base64_encode($body));
+    $response = $coordinator->handle(['REQUEST_METHOD' => $method, 'REQUEST_URI' => $path,
+        'HTTP_AUTHORIZATION' => $credential, 'CONTENT_TYPE' => $media,
+        'CONTENT_LENGTH' => (string) strlen($body)], $query);
+    directoryExpect(1, $sink->attempts, 'exactly one sink attempt');
+    $summary = $sink->summary;
+    if (!$summary instanceof RequestSummary) {
+        throw new RuntimeException('Missing summary.');
+    }
+    directoryExpect($budget->used(), $summary->queryStatements, 'observed statement count');
+    directoryExpect('private, no-store', $response->headers['Cache-Control'] ?? null, 'private cache policy');
+    return ['response' => $response, 'statements' => $budget->used(), 'summary' => $summary,
+        'order' => $log->calls, 'trace' => json_encode($trace->snapshot(), JSON_THROW_ON_ERROR)];
+}
+
+DirectoryFixture::reset(2);
+$small = directoryRequest();
+directoryExpect(200, $small['response']->status, 'small list');
+directoryExpect(1, $small['statements'], 'small list query bound');
+directoryExpect(['authenticate', 'tenant', 'list'], $small['order'], 'list policy order');
+directoryExpect('{"data":[{"id":1,"name":"User 1","email":"user1@example.test"},{"id":2,"name":"User 2","email":"user2@example.test"}],"next_after_user_id":null}' . "\n", $small['response']->body, 'exact scoped list');
+
+$missing = directoryRequest(credential: '');
+directoryExpect(401, $missing['response']->status, 'missing credentials');
+directoryExpect(0, $missing['statements'], 'no unauthenticated SQL');
+directoryExpect(['authenticate'], $missing['order'], 'stop after authentication');
+$rejected = directoryRequest(credential: 'Bearer rejected-private-marker');
+directoryExpect(401, $rejected['response']->status, 'rejected credentials');
+directoryExpect(0, $rejected['statements'], 'no rejected SQL');
+$cross = directoryRequest(path: '/accounts/2/users');
+directoryExpect(403, $cross['response']->status, 'cross account');
+directoryExpect(0, $cross['statements'], 'no cross-account SQL');
+directoryExpect(['authenticate', 'tenant'], $cross['order'], 'stop after tenant');
+$forbidden = directoryRequest('POST', credential: 'Bearer fixture-reader', body: '{"id":8001,"name":"Example","email":"example@example.test"}');
+directoryExpect(403, $forbidden['response']->status, 'reader cannot create');
+directoryExpect(0, $forbidden['statements'], 'no forbidden SQL');
+directoryExpect(['authenticate', 'tenant', 'create'], $forbidden['order'], 'create policy order');
+$failure = directoryRequest(failStage: 'authenticate');
+directoryExpect(500, $failure['response']->status, 'authenticator outage');
+directoryExpect(['authenticate'], $failure['order'], 'no later outage stages');
+directoryExpect(0, $failure['statements'], 'no outage SQL');
+$tenantFailure = directoryRequest(failStage: 'tenant');
+directoryExpect(500, $tenantFailure['response']->status, 'tenant outage');
+directoryExpect(['authenticate', 'tenant'], $tenantFailure['order'], 'no later tenant stages');
+directoryExpect(0, $tenantFailure['statements'], 'no tenant outage SQL');
+$authorizeFailure = directoryRequest(failStage: 'authorize');
+directoryExpect(500, $authorizeFailure['response']->status, 'authorizer outage');
+directoryExpect(0, $authorizeFailure['statements'], 'no authorizer outage SQL');
+
+directoryExpect(400, directoryRequest('POST', body: '{"id":8001,"name":"","email":false}')['response']->status, 'structural precedence');
+$badValue = directoryRequest('POST', body: '{"id":8001,"name":"","email":"ok@example.test"}');
+directoryExpect(422, $badValue['response']->status, 'unacceptable body value');
+directoryExpect(0, $badValue['statements'], 'no invalid-value SQL');
+$badShape = directoryRequest('POST', body: '[]');
+directoryExpect(400, $badShape['response']->status, 'wrong body shape');
+directoryExpect(0, $badShape['statements'], 'no invalid-shape SQL');
+directoryExpect(415, directoryRequest('POST', body: '{}', media: 'text/plain')['response']->status, 'wrong media');
+directoryExpect(413, directoryRequest('POST', body: str_repeat('x', 1025))['response']->status, 'body bound');
+$badCursor = directoryRequest(query: ['after_user_id' => '01']);
+directoryExpect(400, $badCursor['response']->status, 'noncanonical cursor');
+directoryExpect(0, $badCursor['statements'], 'no invalid-cursor SQL');
+directoryExpect(['users' => 3, 'links' => 3, 'events' => 0, 'memberships' => 2], DirectoryFixture::counts(), 'denials preserve all tables');
+
+$created = directoryRequest('POST', body: json_encode(['id' => 101, 'name' => "Literal %_ ' OR 1=1 --", 'email' => 'Synthetic+Label@example.test'], JSON_THROW_ON_ERROR));
+directoryExpect(201, $created['response']->status, 'create success');
+directoryExpect(3, $created['statements'], 'fixed create writes');
+directoryExpect(['users' => 4, 'links' => 4, 'events' => 1, 'memberships' => 2], DirectoryFixture::counts(), 'created user does not become actor');
+$conflict = directoryRequest('POST', body: '{"id":101,"name":"Duplicate","email":"duplicate@example.test"}');
+directoryExpect(409, $conflict['response']->status, 'conflicting ID');
+directoryExpect(1, $conflict['statements'], 'conflict stops writes');
+DirectoryFixture::failAudit();
+$rollback = directoryRequest('POST', body: '{"id":8002,"name":"Rollback","email":"rollback@example.test"}');
+directoryExpect(500, $rollback['response']->status, 'last write failure');
+directoryExpect(3, $rollback['statements'], 'last write attempted');
+directoryExpect(['users' => 4, 'links' => 4, 'events' => 1, 'memberships' => 2], DirectoryFixture::counts(), 'complete transaction rollback');
+$redacted = json_encode([$rejected['response']->body, $rejected['response']->headers, $rejected['summary']->toArray(),
+    $rollback['response']->body, $rollback['summary']->toArray(), $rollback['trace'], $failure['summary']->toArray()], JSON_THROW_ON_ERROR);
+if (str_contains($redacted, 'rejected-private-marker') || str_contains($redacted, 'fixture-private-failure')
+    || str_contains($redacted, 'policy-private-marker') || str_contains($redacted, 'rollback@example.test')
+    || str_contains($redacted, 'INSERT INTO')) {
+    throw new RuntimeException('Private values leaked into observations.');
+}
+DirectoryFixture::reset(500);
+$large = directoryRequest();
+directoryExpect(1, $large['statements'], 'large list constant query bound');
+$decoded = json_decode($large['response']->body, true, 8, JSON_THROW_ON_ERROR);
+if (!is_array($decoded) || !is_array($decoded['data'] ?? null)) {
+    throw new RuntimeException('Invalid list response.');
+}
+directoryExpect(20, count($decoded['data']), 'bounded large page');
+directoryExpect(20, $decoded['next_after_user_id'] ?? null, 'lookahead continuation');
+$page2 = directoryRequest(query: ['after_user_id' => '20']);
+directoryExpect(1, $page2['statements'], 'continuation query bound');
+if (!str_starts_with($page2['response']->body, '{"data":[{"id":21,')) {
+    throw new RuntimeException('Continuation must start after last emitted ID.');
+}
+$last = directoryRequest(query: ['after_user_id' => '499']);
+directoryExpect('{"data":[{"id":500,"name":"User 500","email":"user500@example.test"}],"next_after_user_id":null}' . "\n", $last['response']->body, 'last page without cross-account leak');
+fwrite(STDOUT, "PASS retained Create/List: success, policy order/replacement, denial, input, rollback, redaction, query counts 1/1 (2/500 rows)\n");
