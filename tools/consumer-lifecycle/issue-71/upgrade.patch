+#!/usr/bin/env python3
+"""Contract 18: actual front controller under the real built-in HTTP SAPI."""
+import http.client
+import json
+import os
+from pathlib import Path
+import shutil
+import socket
+import subprocess
+import tempfile
+import time
+
+APP = Path(__file__).resolve().parent.parent
+PHP = shutil.which("php")
+assert PHP
+GENERIC = b'{"error":{"code":"internal_server_error","message":"Internal server error."}}\n'
+SETTINGS = '''file_put_contents(__DIR__ . '/settings.json', json_encode([
+    'all_errors' => (error_reporting() & E_ALL) === E_ALL,
+    'display_errors' => ini_get('display_errors'), 'display_startup_errors' => ini_get('display_startup_errors'),
+    'log_errors' => ini_get('log_errors'), 'ignore_args' => ini_get('zend.exception_ignore_args'),
+    'private_log' => ini_get('error_log') === __DIR__ . '/application.log',
+], JSON_THROW_ON_ERROR));
+'''
+
+def check(scenario, bootstrap, disable_log=False):
+    with tempfile.TemporaryDirectory(prefix="phpthis-directory-outer-") as scratch:
+        root = Path(scratch).resolve()
+        (root / "public").mkdir()
+        shutil.copy2(APP / "public/index.php", root / "public/index.php")
+        os.symlink(APP / "vendor", root / "vendor", target_is_directory=True)
+        (root / "bootstrap.php").write_text(bootstrap)
+        with socket.socket() as sock:
+            sock.bind(("127.0.0.1", 0))
+            port = sock.getsockname()[1]
+        command = [PHP, "-d", "display_errors=0", "-d", "display_startup_errors=0", "-d", "error_reporting=-1",
+            "-d", "log_errors=1", "-d", "zend.exception_ignore_args=1", "-d", f"error_log={root / 'application.log'}"]
+        if disable_log:
+            command += ["-d", "disable_functions=error_log"]
+        command += ["-S", f"127.0.0.1:{port}", "-t", str(root / "public"), str(root / "public/index.php")]
+        with (root / "server.log").open("wb") as output:
+            process = subprocess.Popen(command, cwd=root, stdout=output, stderr=output)
+            try:
+                deadline = time.monotonic() + 5
+                while True:
+                    try:
+                        with socket.create_connection(("127.0.0.1", port), timeout=.2):
+                            break
+                    except OSError:
+                        if process.poll() is not None or time.monotonic() > deadline:
+                            raise AssertionError("HTTP process did not become ready")
+                        time.sleep(.02)
+                connection = http.client.HTTPConnection("127.0.0.1", port, timeout=3)
+                connection.request("POST", "/health?debug=1&disclosure=DEVELOPMENT_DETAILS&environment=development",
+                    body='{"message":"request-private-marker"}',
+                    headers={"Content-Type": "application/json", "X-Debug": "1", "X-Forwarded-For": "127.0.0.1"})
+                response = connection.getresponse()
+                status, headers, body = response.status, dict(response.getheaders()), response.read()
+                connection.close()
+                assert status == 500, (scenario, "status", status)
+                assert body == GENERIC, (scenario, "generic body", body)
+                assert headers.get("Content-Type") == "application/json; charset=utf-8"
+                assert headers.get("Cache-Control") == "private, no-store"
+                assert "X-Request-ID" not in headers
+                settings_file = root / "settings.json"
+                if settings_file.exists():
+                    settings = json.loads(settings_file.read_text())
+                    assert settings == {"all_errors": True, "display_errors": "0", "display_startup_errors": "0",
+                        "log_errors": "1", "ignore_args": "1", "private_log": True}, settings
+                    print("PASS effective HTTP settings", json.dumps(settings, sort_keys=True))
+            finally:
+                process.terminate()
+                try:
+                    process.wait(timeout=5)
+                except subprocess.TimeoutExpired:
+                    process.kill()
+                    process.wait(timeout=5)
+        log_file = root / "application.log"
+        logs = log_file.read_text() if log_file.exists() else ""
+        if disable_log:
+            assert "application.http_outer_failure" not in logs
+        else:
+            event = "application.http_outer_failure failure_class=RuntimeException"
+            lines = logs.splitlines()
+            assert len(lines) == 1 and lines[0].endswith(event), (scenario, logs)
+        assert "private-marker" not in logs and "@anonymous" not in logs and "application.request_summary" not in logs
+        print("PASS outer HTTP", scenario)
+
+# Real missing fixture: exact original bootstrap in a scratch root with no tmp/database.
+check("original bootstrap missing fixture", (APP / "bootstrap.php").read_text())
+check("generic input non-selection", "<?php\ndeclare(strict_types=1);\n" + SETTINGS + "throw new RuntimeException('bootstrap-private-marker');\n")
+check("anonymous class redaction", "<?php\ndeclare(strict_types=1);\nthrow new class('anonymous-private-marker') extends RuntimeException {};\n")
+check("outer event failure isolation", "<?php\ndeclare(strict_types=1);\nthrow new RuntimeException('event-private-marker');\n", True)
