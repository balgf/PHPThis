diff --git a/tests/compatibility.php b/tests/compatibility.php
new file mode 100644
index 0000000..db6fd1d
--- /dev/null
+++ b/tests/compatibility.php
@@ -0,0 +1,85 @@
+<?php
+
+declare(strict_types=1);
+use PHPThis\Http\ErrorResponseRegistry;
+use PHPThis\Http\InvalidRequest;
+use PHPThis\Http\Request;
+use PHPThis\Http\RequestBoundary;
+use PHPThis\Http\RequestHandler;
+use PHPThis\Http\RequestReader;
+use PHPThis\Http\Response;
+use PHPThis\Routing\Route;
+require dirname(__DIR__) . '/vendor/autoload.php';
+final class CompatibilityHandler implements RequestHandler
+{
+    public int $calls = 0;
+    public function handle(Request $request): Response
+    {
+        $this->calls++;
+        return new Response(200, ['Cache-Control' => 'no-store'], 'accepted');
+    }
+}
+$handler = new CompatibilityHandler();
+$boundary = new RequestBoundary(new RequestReader(1024, 'data://text/plain,'), $handler,
+    new ErrorResponseRegistry([InvalidRequest::class => new Response(400, ['Cache-Control' => 'private, no-store'], 'invalid')]));
+foreach (["\x00", "\x09", "\x1f", ' ', "\x7f"] as $byte) {
+    $rejected = $boundary->handle(['REQUEST_METHOD' => 'GET', 'REQUEST_URI' => '/health?value=' . $byte . 'private-marker'], []);
+    if ($rejected->status !== 400 || $rejected->body !== 'invalid' || $handler->calls !== 0) {
+        throw new RuntimeException('Raw target must fail before handler entry.');
+    }
+    try {
+        new Request('GET', '/private-marker' . $byte);
+        throw new RuntimeException('Request accepted an excluded path byte.');
+    } catch (InvalidArgumentException $failure) {
+        if (str_contains($failure->getMessage(), 'private-marker')) { throw new RuntimeException('Request diagnostic leaked.'); }
+    }
+    try {
+        new Route('GET', '/private-marker' . $byte, $handler);
+        throw new RuntimeException('Route accepted an excluded path byte.');
+    } catch (InvalidArgumentException $failure) {
+        if (str_contains($failure->getMessage(), 'private-marker')) { throw new RuntimeException('Route diagnostic leaked.'); }
+    }
+}
+$reader = new RequestReader(1024, 'data://text/plain,');
+foreach (['/a%20b', '/a//b', '/a/../b', '/a\\b', "/high\x80"] as $path) {
+    $request = $reader->read(['REQUEST_METHOD' => 'GET', 'REQUEST_URI' => $path], []);
+    if ($request->path !== $path) { throw new RuntimeException('Raw path unexpectedly normalized.'); }
+}
+
+// Exercise the actual retained controller; cleanup is in the test after observing unchanged buffers.
+$program = <<<'PHP'
+$_SERVER = ['REQUEST_METHOD' => 'GET', 'REQUEST_URI' => '/health'];
+$_GET = []; $_POST = []; $_FILES = [];
+ob_start();
+if ($argv[2] !== 'empty') { echo 'pending-private-marker'; }
+if ($argv[2] === 'lower') { ob_start(); }
+$before = ob_get_level();
+require $argv[1];
+if (ob_get_level() !== $before) { throw new RuntimeException('Controller changed buffer depth.'); }
+$top = ob_get_contents();
+if ($argv[2] === 'lower') {
+    if ($top !== '') { throw new RuntimeException('Controller appended a lower-buffer fallback.'); }
+    ob_end_clean();
+    $top = ob_get_contents();
+}
+$expected = $argv[2] === 'empty' ? "{\"status\":\"ok\"}\n" : 'pending-private-marker';
+if ($top !== $expected) { throw new RuntimeException('Controller changed prior bytes or appended fallback.'); }
+ob_end_clean();
+fwrite(STDOUT, "PASS buffer\n");
+PHP;
+foreach (['empty', 'top', 'lower'] as $mode) {
+    $process = proc_open([PHP_BINARY, '-d', 'display_errors=0', '-d', 'error_reporting=-1', '-r', $program,
+        dirname(__DIR__) . '/public/index.php', $mode],
+        [0 => ['pipe', 'r'], 1 => ['pipe', 'w'], 2 => ['pipe', 'w']], $pipes);
+    if (!is_resource($process)) { throw new RuntimeException('Cannot start buffer evidence.'); }
+    fclose($pipes[0]);
+    $output = stream_get_contents($pipes[1]);
+    $errors = stream_get_contents($pipes[2]);
+    fclose($pipes[1]); fclose($pipes[2]);
+    if (proc_close($process) !== 0 || $output !== "PASS buffer\n" || !is_string($errors)) {
+        throw new RuntimeException('Failed real controller buffer evidence.');
+    }
+    $attempts = substr_count($errors, 'application.response_emission_failed');
+    if ($attempts !== ($mode === 'empty' ? 0 : 1)) { throw new RuntimeException('Wrong emission attempt boundary.'); }
+}
