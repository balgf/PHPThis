diff --git a/tests/directory-boundaries.php b/tests/directory-boundaries.php
new file mode 100644
index 0000000..841499e
--- /dev/null
+++ b/tests/directory-boundaries.php
@@ -0,0 +1,51 @@
+<?php
+
+declare(strict_types=1);
+use EvaluationTests\DirectoryFixture;
+
+DirectoryFixture::reset(2);
+$beforeInvalidInput = DirectoryFixture::counts();
+
+/** @param array<string, mixed> $query */
+function expectRejectedDirectoryQuery(array $query, string $label): void
+{
+    $result = directoryRequest(query: $query);
+    directoryExpect(400, $result['response']->status, $label);
+    directoryExpect(0, $result['statements'], $label . ' before protected SQL');
+}
+expectRejectedDirectoryQuery(['after_user_id' => '9223372036854775808'], 'cursor overflow');
+expectRejectedDirectoryQuery(['after_user_id' => null], 'cursor null');
+expectRejectedDirectoryQuery(['after_user_id' => ['1']], 'cursor array');
+expectRejectedDirectoryQuery(['after_user_id' => ''], 'cursor empty');
+expectRejectedDirectoryQuery(['unknown-private-marker' => 'value-private-marker'], 'unknown query key');
+$structuralFirst = directoryRequest('POST', body: '{"email":false,"name":"","id":8002}');
+directoryExpect(400, $structuralFirst['response']->status, 'wrong type before unacceptable value');
+directoryExpect(0, $structuralFirst['statements'], 'wrong type first no SQL');
+$valueFirst = directoryRequest('POST', body: '{"name":"","id":8002,"email":false}');
+directoryExpect(400, $valueFirst['response']->status, 'wrong type after unacceptable value');
+directoryExpect(0, $valueFirst['statements'], 'wrong type last no SQL');
+directoryExpect($structuralFirst['response']->body, $valueFirst['response']->body, 'same generic structural response');
+$asciiBoundary = directoryRequest(query: ['search' => str_repeat('x', 80)]);
+directoryExpect(200, $asciiBoundary['response']->status, '80 ASCII bytes accepted');
+directoryExpect(1, $asciiBoundary['statements'], 'accepted boundary executes one query');
+$utf8Boundary = directoryRequest(query: ['search' => str_repeat('é', 40)]);
+directoryExpect(200, $utf8Boundary['response']->status, '80 UTF-8 bytes accepted');
+directoryExpect(1, $utf8Boundary['statements'], 'UTF-8 boundary executes one query');
+expectRejectedDirectoryQuery(['search' => str_repeat('é', 40) . 'x'], '81 UTF-8 bytes rejected');
+directoryExpect($beforeInvalidInput, DirectoryFixture::counts(), 'all boundary probes leave tables unchanged');
+
+// Policies succeed using their synthetic snapshot, while storage membership has disappeared.
+DirectoryFixture::removeWriterMembership();
+$withoutMembership = DirectoryFixture::counts();
+$staleList = directoryRequest();
+directoryExpect(['authenticate', 'tenant', 'list'], $staleList['order'], 'stale actor reaches list SQL');
+directoryExpect(200, $staleList['response']->status, 'missing membership list is an empty page');
+directoryExpect("{\"data\":[],\"next_after_user_id\":null}\n", $staleList['response']->body, 'SQL membership predicate excludes all rows');
+directoryExpect(1, $staleList['statements'], 'list rechecks storage in one statement');
+$staleCreate = directoryRequest('POST', body: '{"id":8002,"name":"Stale actor","email":"stale@example.test"}');
+directoryExpect(['authenticate', 'tenant', 'create'], $staleCreate['order'], 'stale actor reaches create SQL');
+directoryExpect(409, $staleCreate['response']->status, 'missing membership create conflict');
+directoryExpect(1, $staleCreate['statements'], 'create stops at first guarded insert');
+directoryExpect($withoutMembership, DirectoryFixture::counts(), 'stale membership cannot mutate any table');
+DirectoryFixture::reset(500); // Restore the documented starting fixture for the next HTTP module.
+fwrite(STDOUT, "PASS review regressions: SQL membership rechecks, cursor shapes/overflow, structural precedence, 80/81-byte UTF-8 search\n");
